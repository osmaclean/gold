# ─── Supabase ──────────────────────────────────────────
# Cria projeto em https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# ─── Postgres (vem do Supabase: Project Settings -> Database) ──────────
# Pooler (PgBouncer) — usado em runtime
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection — usado em prisma migrate
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ─── Admins seed ───────────────────────────────────────
# E-mails (separados por vírgula) que recebem role ADMIN no primeiro login
ADMIN_EMAILS="lucas@exemplo.com,outro-admin@exemplo.com,terceiro@exemplo.com"

# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Tropa da Gold"
